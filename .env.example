# このファイルを .env にコピーして書き換える（.env は絶対に人に見せない・gitに入れない）

# アプリのログインパスワード（長めに）
APP_PASSWORD=
# ランダムな文字列 32文字以上（例: openssl rand -hex 32 の結果）
SECRET_KEY=
# サーバーのドメイン（HTTPS用。例: keiba.example.com）
DOMAIN=

# 本番投票を許可するか（1で許可。まずは空のまま練習・リハーサルで確認する）
ALLOW_LIVE=

# スマホ通知（ntfyアプリで購読するURL。トピック名は推測されない長い文字列に）
NTFY_URL=https://ntfy.sh/

# 即PAT
IPAT_INET_ID=
IPAT_SUBSCRIBER_NO=
IPAT_PIN=
IPAT_PARS=

# SPAT4
SPAT4_SUBSCRIBER_NO=
SPAT4_USER_ID=
SPAT4_PIN=
