{
  "_note": "即PAT（PC版）の操作手順。2026/10/31に本物の画面で、ログインから購入・投票履歴の払戻まで確認済み。",
  "required": [
    "inet_id",
    "subscriber",
    "pin",
    "pars"
  ],
  "timeout": 15000,
  "login": [
    {
      "do": "goto",
      "url": "https://www.ipat.jra.go.jp/"
    },
    {
      "do": "fill",
      "sel": "input[name='inetid']",
      "value": "{inet_id}"
    },
    {
      "do": "click",
      "sel": "a:has-text('ログイン'), button:has-text('ログイン'), .button"
    },
    {
      "do": "fill",
      "sel": "input[name='i']",
      "value": "{subscriber}"
    },
    {
      "do": "fill",
      "sel": "input[name='p']",
      "value": "{pin}"
    },
    {
      "do": "fill",
      "sel": "input[name='r']",
      "value": "{pars}"
    },
    {
      "do": "click",
      "sel": "a[onclick*='ToModernMenu']",
      "js_fallback": "ToModernMenu()"
    },
    {
      "do": "click",
      "sel": "button:has-text('OK')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "wait_for",
      "sel": "button[href='#!/bet/basic']"
    }
  ],
  "post_time": [
    {
      "do": "click",
      "sel": "a[href='#!/']:has-text('投票メニュー'), button:has-text('トップ'), a:has-text('トップ')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": ".ipat-error-window:not(.ng-hide) button.btn-ok",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button[href='#!/bet/basic']"
    },
    {
      "do": "click",
      "sel": "button:has-text('このまま進む')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button:has-text('{venue}')"
    },
    {
      "do": "read_time",
      "sel": "button:has-text('{race_no}R')",
      "var": "post_time"
    }
  ],
  "open_race": [
    {
      "do": "click",
      "sel": "a[href='#!/']:has-text('投票メニュー'), button:has-text('トップ'), a:has-text('トップ')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": ".ipat-error-window:not(.ng-hide) button.btn-ok",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button[href='#!/bet/basic']"
    },
    {
      "do": "click",
      "sel": "button:has-text('このまま進む')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button:has-text('{venue}')"
    },
    {
      "do": "click",
      "sel": "button:has-text('{race_no}R')"
    }
  ],
  "read_odds": [
    {
      "do": "read",
      "sel": "tr:has(racer-no[n-horse-no='{num}']) td.racer-odds .odds-num",
      "var": "odds",
      "timeout": 4000
    }
  ],
  "ticket": [
    {
      "do": "select",
      "sel": "select#bet-basic-type",
      "label": "{bet_label}"
    },
    {
      "do": "select",
      "sel": "select#bet-basic-method",
      "label": "{method_label}",
      "optional": true,
      "timeout": 2000
    },
    {
      "do": "pick"
    },
    {
      "do": "fill",
      "sel": "input[ng-model='vm.nUnit'], input.amount",
      "value": "{units}"
    },
    {
      "do": "click",
      "sel": "button.btn-set:text-is('セット')"
    }
  ],
  "pick": [
    {
      "do": "click",
      "sel": "label[for='horse{col}_no{num}'], label[for='no{num}']"
    }
  ],
  "confirm": [
    {
      "do": "click",
      "sel": "button:has-text('入力終了')"
    },
    {
      "do": "expect_text",
      "text": "{total_comma}円"
    },
    {
      "do": "fill",
      "sel": "input[ng-model='vm.cAmountTotal'], input[placeholder*='合計']",
      "value": "{total}"
    }
  ],
  "purchase": [
    {
      "do": "click",
      "sel": "button:has-text('購入する')"
    },
    {
      "do": "click",
      "sel": "button:has-text('OK')",
      "optional": true,
      "timeout": 5000
    }
  ],
  "done_check": [
    {
      "do": "wait_for",
      "sel": "text=/受付番号|受け付けました|受付しました/",
      "timeout": 20000
    }
  ],
  "cancel": [
    {
      "do": "click",
      "sel": "button.btn-vote-list",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "a:text-is('全て削除')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button:has-text('OK'), button:has-text('はい')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "button:text-is('閉じる')",
      "optional": true,
      "timeout": 3000
    }
  ],
  "bet_labels": {
    "3連複": "３連複",
    "3連単": "３連単"
  },
  "receipts_open": [
    {
      "do": "click",
      "sel": "button:text-is('閉じる')",
      "optional": true,
      "timeout": 2000
    },
    {
      "do": "click",
      "sel": "button.btn-reference"
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "receipts": {
    "links": "td.receipt:has(span.icon-return) a",
    "rows": "tr[ng-repeat^='oNb in vm.oBetReferDetail']",
    "receipt_payout": ".betmoney"
  }
}
