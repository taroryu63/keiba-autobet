{
  "_note": "SPAT4（PC版）の操作手順。ログイン〜マークカード・金額入力・確認画面（2026/10）は確認済み。投票した後の画面は未確認。",
  "required": [
    "subscriber",
    "user_id",
    "pin"
  ],
  "timeout": 15000,
  "login": [
    {
      "do": "goto",
      "url": "https://www.spat4.jp/keiba/pc"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERNUMR']",
      "value": "{subscriber}"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERIDR']",
      "value": "{user_id}"
    },
    {
      "do": "click",
      "sel": "a.loginbtn, a[name='B1'], input[type='submit'][value*='ログイン'], button:has-text('ログイン')",
      "timeout": 8000,
      "js_fallback": "loginCheck()"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERPASSR']",
      "value": "{pin}",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "a.loginbtn, input[type='submit'], button:has-text('ログイン'), a:has-text('ログイン')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "wait_for",
      "sel": "text=/投票/"
    }
  ],
  "post_time": [
    {
      "do": "main_window"
    },
    {
      "do": "click",
      "sel": "input[value='開催要領']",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "click",
      "sel": "text=\"{venue}\"",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "wait_for",
      "sel": "text=/{venue}競馬/",
      "timeout": 10000
    },
    {
      "do": "read_time",
      "sel": "tr:has(td :text-is('{race_no}R')), tr:has(td:text-is('{race_no}R'))",
      "var": "post_time"
    }
  ],
  "open_race": [
    {
      "do": "main_window"
    },
    {
      "do": "click",
      "sel": "input[value='開催要領']",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "click",
      "sel": "text=\"{venue}\"",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "wait_for",
      "sel": "text=/{venue}競馬/",
      "timeout": 10000
    },
    {
      "do": "click",
      "sel": "tr:has(td :text-is('{race_no}R')) :text-is('{race_no}R'), tr td:text-is('{race_no}R')"
    },
    {
      "do": "click",
      "sel": "input[value*='マークカード'], img[alt*='マークカード'], :text('マークカード投票')",
      "new_window": true
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "read_odds": [
    {
      "do": "main_window"
    },
    {
      "do": "click",
      "sel": "input[value='開催要領']",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "click",
      "sel": "text=\"{venue}\"",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "wait_for",
      "sel": "text=/{venue}競馬/",
      "timeout": 10000
    },
    {
      "do": "click",
      "sel": "tr:has(td :text-is('{race_no}R')) :text-is('{race_no}R'), tr td:text-is('{race_no}R')"
    },
    {
      "do": "click",
      "sel": "input[value='オッズ投票'], input[value*='オッズ']",
      "new_window": true
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "read",
      "sel": "tr:has(td:nth-child(2):text-is('{num}')), tr:has(td:nth-child(1):text-is('{num}'))",
      "pattern": "decimal",
      "var": "odds",
      "timeout": 6000
    }
  ],
  "ticket": [
    {
      "do": "click",
      "text": "{bet_label}",
      "onscreen": true
    },
    {
      "do": "pick"
    }
  ],
  "pick": [
    {
      "do": "click",
      "sel": "button.num.no-{num}",
      "onscreen": true,
      "index": "{card0}"
    }
  ],
  "confirm": [
    {
      "do": "click",
      "text": "投票内容確認へ",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "do": "click",
      "text": "OK",
      "onscreen": true,
      "optional": true,
      "timeout": 1000
    },
    {
      "do": "expect_text",
      "text": "合計金額{total_comma}円",
      "onscreen": true
    },
    {
      "do": "fill",
      "sel": "input[name='cfm_ansho']",
      "value": "{pin}"
    },
    {
      "do": "fill",
      "sel": "input[name='cfm_amount']",
      "value": "{total}"
    }
  ],
  "purchase": [
    {
      "do": "click",
      "text": "投票する",
      "onscreen": true
    }
  ],
  "done_check": [
    {
      "do": "wait_for",
      "sel": "text=/受付番号|受け付けました|投票を受け付け/",
      "timeout": 20000
    }
  ],
  "cancel": [
    {
      "do": "click",
      "sel": "input[value*='取消'], a:has-text('全て取消')",
      "optional": true,
      "timeout": 3000
    }
  ],
  "result": [
    {
      "do": "click",
      "sel": "a:has-text('投票照会'), a:has-text('照会')"
    },
    {
      "do": "has",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R'):has-text('払戻')",
      "var": "settled"
    },
    {
      "do": "read",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R') .payout",
      "var": "payout",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "has",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R'):has-text('単勝'):has-text('的中')",
      "var": "tansho_hit"
    }
  ],
  "post_time_add_min": 2,
  "bet_labels": {
    "枠連": "枠複",
    "馬連": "馬複",
    "3連複": "三連複",
    "3連単": "三連単"
  },
  "cards_per_page": 6,
  "entry_mode": "groups",
  "cards_tab": [
    {
      "do": "click",
      "text": "単･複･連勝複式",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 500
    }
  ],
  "nagashi": [
    {
      "do": "click",
      "text": "連複流し",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "click",
      "text": "{bet_label}",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 300
    }
  ],
  "to_amount": [
    {
      "do": "click",
      "text": "投票金額入力へ",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "amount": [
    {
      "do": "fill",
      "sel": "input.input.number:not([name])",
      "onscreen": true,
      "index": "{row}",
      "value": "{units}"
    }
  ],
  "add_more": [
    {
      "do": "click",
      "text": "買い目を追加する",
      "onscreen": true
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "odds_before_open": true
}
