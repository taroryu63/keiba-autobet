{
  "_note": "SPAT4（PC版）の操作手順。ログイン〜マークカードの券種・馬番（2026/10の画面）は確認済み。金額入力から先は未確認。",
  "required": [
    "subscriber",
    "user_id",
    "pin"
  ],
  "timeout": 15000,
  "login": [
    {
      "do": "goto",
      "url": "https://www.spat4.jp/keiba/pc"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERNUMR']",
      "value": "{subscriber}"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERIDR']",
      "value": "{user_id}"
    },
    {
      "do": "click",
      "sel": "a.loginbtn, a[name='B1'], input[type='submit'][value*='ログイン'], button:has-text('ログイン')",
      "timeout": 8000,
      "js_fallback": "loginCheck()"
    },
    {
      "do": "fill",
      "sel": "input[name='MEMBERPASSR']",
      "value": "{pin}",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "click",
      "sel": "a.loginbtn, input[type='submit'], button:has-text('ログイン'), a:has-text('ログイン')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "wait_for",
      "sel": "text=/投票/"
    }
  ],
  "post_time": [
    {
      "do": "click",
      "sel": "text=\"{venue}\"",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "wait_for",
      "sel": "text=/{venue}競馬/",
      "timeout": 10000
    },
    {
      "do": "read_time",
      "sel": "tr:has(td :text-is('{race_no}R')), tr:has(td:text-is('{race_no}R'))",
      "var": "post_time"
    }
  ],
  "open_race": [
    {
      "do": "click",
      "sel": "text=\"{venue}\"",
      "optional": true,
      "timeout": 5000
    },
    {
      "do": "wait_for",
      "sel": "text=/{venue}競馬/",
      "timeout": 10000
    },
    {
      "do": "click",
      "sel": "tr:has(td :text-is('{race_no}R')) :text-is('{race_no}R'), tr td:text-is('{race_no}R')"
    },
    {
      "do": "click",
      "sel": "input[value*='マークカード'], img[alt*='マークカード'], :text('マークカード投票')",
      "new_window": true
    },
    {
      "do": "wait",
      "ms": 1500
    }
  ],
  "read_odds": [
    {
      "do": "read",
      "sel": "tr:has(td:text-is('{num}')) td.tanOdds, tr:has(td:text-is('{num}')) .odds",
      "var": "odds",
      "timeout": 4000
    }
  ],
  "ticket": [
    {
      "do": "click",
      "sel": ":text-is('{bet_label}')"
    },
    {
      "do": "pick"
    }
  ],
  "pick": [
    {
      "do": "click",
      "sel": ":nth-match(button.num.no-{num}, {card})"
    }
  ],
  "confirm": [
    {
      "do": "click",
      "sel": ":text-is('投票金額入力へ')"
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "do": "fill",
      "sel": "input[type='text'], input[type='tel'], input[type='number']",
      "value": "{units}"
    },
    {
      "do": "click",
      "sel": ":text-is('投票内容確認へ')"
    },
    {
      "do": "expect_text",
      "text": "{total_comma}円"
    }
  ],
  "purchase": [
    {
      "do": "click",
      "sel": "input[value*='投票する'], button:has-text('投票する'), a:has-text('投票する')"
    }
  ],
  "done_check": [
    {
      "do": "wait_for",
      "sel": "text=/受付番号|受け付けました|投票を受け付け/",
      "timeout": 20000
    }
  ],
  "cancel": [
    {
      "do": "click",
      "sel": "input[value*='取消'], a:has-text('全て取消')",
      "optional": true,
      "timeout": 3000
    }
  ],
  "result": [
    {
      "do": "click",
      "sel": "a:has-text('投票照会'), a:has-text('照会')"
    },
    {
      "do": "has",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R'):has-text('払戻')",
      "var": "settled"
    },
    {
      "do": "read",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R') .payout",
      "var": "payout",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "has",
      "sel": "tr:has-text('{venue}'):has-text('{race_no}R'):has-text('単勝'):has-text('的中')",
      "var": "tansho_hit"
    }
  ],
  "post_time_add_min": 2,
  "bet_labels": {
    "枠連": "枠複",
    "馬連": "馬複",
    "3連複": "三連複",
    "3連単": "三連単"
  },
  "cards_per_page": 6,
  "next_cards": [],
  "probe": [
    {
      "do": "click",
      "sel": ":text-is('連複流し')"
    },
    {
      "do": "wait",
      "ms": 800
    },
    {
      "do": "click",
      "sel": ":text-is('ワイド')",
      "optional": true,
      "timeout": 3000
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "probe_back": [
    {
      "do": "click",
      "sel": ":text-is('単･複･連勝複式'), :text-is('単・複・連勝複式')"
    },
    {
      "do": "wait",
      "ms": 800
    }
  ],
  "max_tickets_per_vote": 6
}
